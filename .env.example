FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_APP_TOKEN=
FEISHU_TABLE_ID=

# 过程记录(附件)长期存档的云文档根目录 token。
# 从文件夹链接 https://<租户>.feishu.cn/drive/folder/<这一段> 里取。
# **留空 = 关闭上传**:过程记录退回「只在 PR 正文里列文件名」,原件不留存。
# 前提:应用需有 drive:drive 权限,且该文件夹已**共享给应用**(两者缺一,
# worker 会在启动自检时直接失败,不会带到每一行去重试)。
FEISHU_DRIVE_FOLDER_TOKEN=
# 单文件上传上限(字节)。飞书 upload_all 接口硬限制 20MB,调大也无用 ——
# 更大的文件要走分片上传,当前未实现,超限会直接报错且不建 PR。
FEISHU_DRIVE_MAX_FILE_BYTES=20971520
# 拼云文档链接用的租户域名
FEISHU_HOST=jfpolymers.feishu.cn

# Git 仓库 https URL(支持 GitHub / Gitea),例如:
#   https://github.com/owner/repo.git
GIT_REPOSITORY_URL=
# GitHub / Gitea 的 Personal Access Token(需仓库读写权限)
GIT_ACCESS_TOKEN=

POLL_INTERVAL=5
# 瞬时故障(Git/网络)自动重试上限,超过后标记为失败
MAX_RETRIES=5

# 源表格，用于从 DER 表格同步数据，由 migrate_der_to_pst.py 消费
app_token=
table_id=